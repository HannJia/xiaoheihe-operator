      "layout": "document",
      "queries": {
        "status": {
          "api": "webui_login_status"
        }
      },
      "actions": {
        "request_qr": {
          "api": "webui_request_login",
          "confirmation": "确认生成新的小黑盒登录二维码？"
        }
      }
    }
  ]
}
