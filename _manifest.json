{
  "manifest_version": 2,
  "id": "org.orge-8.xiaoheihe-operator",
  "version": "0.5.0",
  "name": "小黑盒运营",
  "description": "让 MaiBot 用自己的人设在小黑盒逛帖、点赞、评论和发帖，可联动生活轨迹和配图。",
  "author": {
    "name": "HannJia",
    "url": "https://github.com/HannJia"
  },
  "urls": {
    "repository": "https://github.com/HannJia/xiaoheihe-operator"
  },
  "license": "MIT",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png",
      "fallback": "package",
      "background": "#f1f2f4"
    }
  },
  "host_application": {
    "min_version": "1.3.6",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "api.call",
    "config.get",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "plugin_type": "integration"
}
