{
  "manifest_version": 2,
  "id": "org.orge-8.xiaoheihe-operator",
  "version": "0.3.8",
  "name": "小黑盒运营",
  "description": "将 maibot 的生活轨迹、游戏话题和配图能力接入小黑盒社区。",
  "author": {
    "name": "HannJia",
    "url": "https://github.com/HannJia"
  },
  "urls": {
    "repository": "https://github.com/HannJia/xiaoheihe-operator"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.3.6",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "999.999.999"
  },
  "dependencies": [
    {
      "type": "plugin",
      "id": "maimai-drawpic-plugin",
      "version_spec": ">=2.1.1"
    },
    {
      "type": "plugin",
      "id": "org.mai-mai.self-identity",
      "version_spec": ">=1.3.3"
    },
    {
      "type": "plugin",
      "id": "org.orge-8.life-frequency",
      "version_spec": ">=1.22.4"
    }
  ],
  "capabilities": [
    "api.call",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "plugin_type": "integration"
}
