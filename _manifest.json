{
  "manifest_version": 2,
  "id": "org.orge-8.xiaoheihe-operator",
  "version": "0.4.0",
  "name": "小黑盒运营",
  "description": "将 maibot 的生活轨迹、游戏话题和配图能力接入小黑盒社区。",
  "author": {
    "name": "HannJia",
    "url": "https://github.com/HannJia"
  },
  "urls": {
    "repository": "https://github.com/HannJia/xiaoheihe-operator"
  },
  "license": "MIT",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png",
      "fallback": "package",
      "background": "#f1f2f4"
    }
  },
  "host_application": {
    "min_version": "1.3.6",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.12.99"
  },
  "dependencies": [],
  "capabilities": [
    "api.call",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "plugin_type": "integration"
}
